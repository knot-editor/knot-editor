{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.Disposable"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": false
  },
  "include": [
    "../../crates/knot-host/src/js/knot.d.ts",
    "examples/*.js",
    "examples/*.d.ts",
    "contract.test.ts"
  ]
}
