{
  // The host's own modules, compiled module for module and embedded in the
  // engine. Standalone rather than extending the extension base so that
  // package settings never rebuild the host.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.Disposable"],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "skipLibCheck": false,
    "rootDir": ".",
    "paths": { "knot:bootstrap": ["./bootstrap.ts"] }
  },
  "files": ["knot.d.ts", "native.d.ts", "bootstrap.ts", "knot.ts", "contract.ts"]
}
