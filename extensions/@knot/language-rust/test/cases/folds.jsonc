// Fold region cases, run through an editor view on each listed language. A
// regions case lists the regions of `before` as `first-last` pairs of 0-based
// lines, both included, ordered by first line and then outermost first.
{
  "languages": ["rust"],
  "regions": [
    {
      "name": "bodies fold and leave their closing brace visible",
      "before": [
        "impl T {",
        "    fn f() {",
        "        a;",
        "        b;",
        "    }",
        "",
        "    fn g() { c }",
        "}"
      ],
      "after": ["0-6", "1-3"]
    },
    {
      "name": "an else keeps its line visible",
      "before": ["fn f() {", "    if x {", "        a;", "    } else {", "        b;", "    }", "}"],
      "after": ["0-5", "1-2", "3-4"]
    },
    {
      "name": "structs, enums, matches, calls, and block comments fold",
      "before": [
        "struct S {",
        "    a: u8,",
        "}",
        "enum E {",
        "    A,",
        "}",
        "/* one",
        "   two */",
        "fn f() {",
        "    match x {",
        "        0 => {}",
        "        _ => g(",
        "            1,",
        "        ),",
        "    }",
        "}"
      ],
      "after": ["0-1", "3-4", "6-7", "8-14", "9-13", "11-12"]
    }
  ]
}
