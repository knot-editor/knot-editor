// Indentation cases, run through an editor view on each listed language.
// Lines join with "\n" and "‸" marks the caret: one marker places it, two
// select between them. A reindent case reindents the marked lines, or every
// line without a marker, and expects `after`. An enter case presses Enter at
// the marked selection and expects `after` with the caret at its marker.
{
  "languages": ["rust"],
  "enter": [
    { "name": "after an unclosed opening brace", "before": ["fn main() {‸"], "after": ["fn main() {", "    ‸"] },
    {
      "name": "in an unclosed function body",
      "before": ["fn main() {", "    a();‸"],
      "after": ["fn main() {", "    a();", "    ‸"]
    },
    {
      "name": "after an unclosed block inside a function",
      "before": ["fn f() {", "    let x = 1;", "    if x {‸", "    b();", "}"],
      "after": ["fn f() {", "    let x = 1;", "    if x {", "        ‸", "    b();", "}"]
    },
    {
      "name": "in an unclosed block inside a function",
      "before": ["fn f() {", "    if x {", "        a();‸", "    b();", "}", "", "fn g() {}"],
      "after": ["fn f() {", "    if x {", "        a();", "        ‸", "    b();", "}", "", "fn g() {}"]
    },
    {
      "name": "after an unclosed parenthesis",
      "before": ["fn f() {", "    call(a,‸", "}"],
      "after": ["fn f() {", "    call(a,", "        ‸", "}"]
    },
    {
      "name": "between braces opens a middle line",
      "before": ["fn main() {‸}"],
      "after": ["fn main() {", "    ‸", "}"]
    },
    {
      "name": "between parentheses",
      "before": ["fn f() {", "    call(‸);", "}"],
      "after": ["fn f() {", "    call(", "        ‸", "    );", "}"]
    },
    {
      "name": "between brackets",
      "before": ["fn f() {", "    let v = [‸];", "}"],
      "after": ["fn f() {", "    let v = [", "        ‸", "    ];", "}"]
    },
    {
      "name": "whitespace between the pair goes",
      "before": ["fn main() { ‸ }"],
      "after": ["fn main() {", "    ‸", "}"]
    },
    {
      "name": "after a statement",
      "before": ["fn f() {", "    a();‸", "}"],
      "after": ["fn f() {", "    a();", "    ‸", "}"]
    },
    {
      "name": "after an over-indented statement",
      "before": ["fn f() {", "          a();‸", "}"],
      "after": ["fn f() {", "          a();", "    ‸", "}"]
    },
    {
      "name": "after a closing brace",
      "before": ["fn f() {", "    if x {", "        y();", "    }‸", "}"],
      "after": ["fn f() {", "    if x {", "        y();", "    }", "    ‸", "}"]
    },
    {
      "name": "after an opening brace with a trailing comment",
      "before": ["fn f() { // body‸", "}"],
      "after": ["fn f() { // body", "    ‸", "}"]
    },
    {
      "name": "after a match opening brace",
      "before": ["fn f(x: u8) {", "    match x {‸", "    }", "}"],
      "after": ["fn f(x: u8) {", "    match x {", "        ‸", "    }", "}"]
    },
    {
      "name": "moving arguments onto their own line",
      "before": ["fn f() {", "    call(a, ‸b);", "}"],
      "after": ["fn f() {", "    call(a, ", "        ‸b);", "}"]
    },
    {
      "name": "moving parameters onto their own line",
      "before": ["fn f(a: u32, ‸b: u32) {}"],
      "after": ["fn f(a: u32, ", "    ‸b: u32) {}"]
    },
    {
      "name": "a selection is replaced",
      "before": ["fn f() {‸ a(); ‸}"],
      "after": ["fn f() {", "    ‸", "}"]
    },
    {
      "name": "a whitespace-only line keeps none of it",
      "before": ["fn f() {", "    ‸", "}"],
      "after": ["fn f() {", "", "    ‸", "}"]
    },
    {
      "name": "inside a string the line's indentation is kept",
      "before": ["fn f() {", "    let s = \"one‸two\";", "}"],
      "after": ["fn f() {", "    let s = \"one", "    ‸two\";", "}"]
    },
    {
      "name": "inside a block comment the line's indentation is kept",
      "before": ["fn f() {", "    /*", "     * One.‸", "     */", "}"],
      "after": ["fn f() {", "    /*", "     * One.", "     ‸", "     */", "}"]
    },
    {
      "name": "after a line comment",
      "before": ["fn f() {", "    // note‸", "}"],
      "after": ["fn f() {", "    // note", "    ‸", "}"]
    },
    {
      "name": "tab-indented files indent with tabs",
      "before": ["fn f() {", "\tif x {‸", "\t}", "}"],
      "after": ["fn f() {", "\tif x {", "\t\t‸", "\t}", "}"]
    }
  ],
  "reindent": [
    {
      "name": "nested blocks",
      "before": ["fn main() {", "let a = 1;", "if a > 0 {", "for i in 0..a {", "b(i);", "}", "}", "}"],
      "after": ["fn main() {", "    let a = 1;", "    if a > 0 {", "        for i in 0..a {", "            b(i);", "        }", "    }", "}"]
    },
    {
      "name": "over-indented lines come back",
      "before": ["fn main() {", "            a();", "        }"],
      "after": ["fn main() {", "    a();", "}"]
    },
    {
      "name": "else and closing braces",
      "before": ["fn f() {", "if a {", "b();", "} else if c {", "d();", "} else {", "e();", "}", "}"],
      "after": ["fn f() {", "    if a {", "        b();", "    } else if c {", "        d();", "    } else {", "        e();", "    }", "}"]
    },
    {
      "name": "match arms and arm blocks",
      "before": ["fn f(x: u8) -> u8 {", "match x {", "0 => 1,", "1 => {", "let y = 2;", "y", "}", "_ => 3,", "}", "}"],
      "after": ["fn f(x: u8) -> u8 {", "    match x {", "        0 => 1,", "        1 => {", "            let y = 2;", "            y", "        }", "        _ => 3,", "    }", "}"]
    },
    {
      "name": "method chains indent one level",
      "before": ["fn f() {", "let v = items", ".iter()", ".map(|x| x + 1)", ".collect::<Vec<_>>();", "}"],
      "after": ["fn f() {", "    let v = items", "        .iter()", "        .map(|x| x + 1)", "        .collect::<Vec<_>>();", "}"]
    },
    {
      "name": "hanging arguments and their closing parenthesis",
      "before": ["fn f() {", "call(", "first,", "second,", ");", "}"],
      "after": ["fn f() {", "    call(", "        first,", "        second,", "    );", "}"]
    },
    {
      "name": "arguments after the open parenthesis indent one level",
      "before": ["fn f() {", "call(first,", "second);", "}"],
      "after": ["fn f() {", "    call(first,", "        second);", "}"]
    },
    {
      "name": "multi-line parameters, arrays, and struct literals",
      "before": [
        "fn f(",
        "a: u32,",
        "b: u32,",
        ") -> Point {",
        "let v = [",
        "1,",
        "2,",
        "];",
        "Point {",
        "x: a,",
        "y: b,",
        "}",
        "}"
      ],
      "after": [
        "fn f(",
        "    a: u32,",
        "    b: u32,",
        ") -> Point {",
        "    let v = [",
        "        1,",
        "        2,",
        "    ];",
        "    Point {",
        "        x: a,",
        "        y: b,",
        "    }",
        "}"
      ]
    },
    {
      "name": "struct, enum, impl, trait, and mod bodies",
      "before": [
        "mod m {",
        "struct S {",
        "a: u8,",
        "}",
        "enum E {",
        "A,",
        "B(u8),",
        "}",
        "trait T {",
        "fn t(&self);",
        "}",
        "impl T for S {",
        "fn t(&self) {}",
        "}",
        "}"
      ],
      "after": [
        "mod m {",
        "    struct S {",
        "        a: u8,",
        "    }",
        "    enum E {",
        "        A,",
        "        B(u8),",
        "    }",
        "    trait T {",
        "        fn t(&self);",
        "    }",
        "    impl T for S {",
        "        fn t(&self) {}",
        "    }",
        "}"
      ]
    },
    {
      "name": "where clauses",
      "before": ["impl<T> Show for Wrapper<T>", "where", "T: Display,", "{", "fn show(&self) {}", "}"],
      "after": ["impl<T> Show for Wrapper<T>", "where", "    T: Display,", "{", "    fn show(&self) {}", "}"]
    },
    {
      "name": "use lists",
      "before": ["use std::{", "fmt,", "io,", "};"],
      "after": ["use std::{", "    fmt,", "    io,", "};"]
    },
    {
      "name": "lines inside a string keep their indentation",
      "before": ["fn f() {", "let s = \"first", "  second", "third\";", "}"],
      "after": ["fn f() {", "    let s = \"first", "  second", "third\";", "}"]
    },
    {
      "name": "lines inside a raw string keep their indentation",
      "before": ["fn f() {", "let s = r#\"", "    {", "  }", "\"#;", "}"],
      "after": ["fn f() {", "    let s = r#\"", "    {", "  }", "\"#;", "}"]
    },
    {
      "name": "a block comment moves with its first line",
      "before": ["fn f() {", "/*", " * One.", " * Two.", " */", "a();", "}"],
      "after": ["fn f() {", "    /*", "     * One.", "     * Two.", "     */", "    a();", "}"]
    },
    {
      "name": "a doc block comment moves with its first line",
      "before": ["mod m {", "        /**", "         * Docs.", "         */", "        fn f() {}", "}"],
      "after": ["mod m {", "    /**", "     * Docs.", "     */", "    fn f() {}", "}"]
    },
    {
      "name": "line and doc comments indent like code",
      "before": ["fn f() {", "// note", "/// docs", "a(); // trailing", "}"],
      "after": ["fn f() {", "    // note", "    /// docs", "    a(); // trailing", "}"]
    },
    {
      "name": "only the marked lines change",
      "before": ["fn f() {", "‸a();", "b();‸", "c();", "}"],
      "after": ["fn f() {", "    a();", "    b();", "c();", "}"]
    },
    {
      "name": "a caret reindents its own line",
      "before": ["fn f() {", "a();", "b‸();", "}"],
      "after": ["fn f() {", "a();", "    b();", "}"]
    },
    {
      "name": "tab-indented files reindent with tabs",
      "before": ["fn f() {", "\tif a {", "b();", "\t}", "}"],
      "after": ["fn f() {", "\tif a {", "\t\tb();", "\t}", "}"]
    },
    {
      "name": "blank lines among several stay as they are",
      "before": ["fn f() {", "a();", "", "b();", "}"],
      "after": ["fn f() {", "    a();", "", "    b();", "}"]
    }
  ]
}
