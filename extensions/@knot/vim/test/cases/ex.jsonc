// Vim behavior cases in the format described in
// crates/knot-ext-vim/tests/vim.rs: a Rust product test types `keys` through the
// real editor with this package enabled. Topic: the Ex line.
{
  "cases": [
    { "name": ":<line> goes to the line's first non-blank", "before": ["‸a", "b", "  c", "d"], "keys": ":3<cr>", "after": ["a", "b", "  ‸c", "d"] },
    { "name": ":$ goes to the last line", "before": ["‸a", "b", "c"], "keys": ":$<cr>", "after": ["a", "b", "‸c"] },
    { "name": "a line past the end goes to the last line", "before": ["‸a", "b"], "keys": ":99<cr>", "after": ["a", "‸b"] },
    { "name": ":<line> is a jump", "before": ["a", "b‸c", "d"], "keys": ":3<cr>``", "after": ["a", "b‸c", "d"] },
    { "name": "ctrl-o returns from :<line>", "before": ["‸a", "b", "c"], "keys": ":3<cr><c-o>", "after": ["‸a", "b", "c"] },
    { "name": "\": holds the last command line", "before": ["‸a", "b"], "keys": ":2<cr>\":p", "after": ["a", "b‸2"] },
    { "name": "an unknown command changes nothing", "before": ["‸a", "b"], "keys": ":frob<cr>", "after": ["‸a", "b"] },
    { "name": "Backspace on an empty Ex line leaves it without running anything", "before": ["‸a", "b"], "keys": ":<bs>j", "after": ["a", "‸b"] },
    { "name": "Backspace deletes Ex text, then leaves the line", "before": ["‸a", "b", "c"], "keys": ":2<bs><bs>j", "after": ["a", "‸b", "c"] },
    { "name": "Escape dismisses the Ex line", "before": ["‸a", "b"], "keys": ":2<esc>j", "after": ["a", "‸b"] },
    { "name": ":set noet indents with tabs", "before": ["‸a"], "keys": ":set noet<cr>>>", "after": ["\t‸a"] },
    { "name": ":set sw sets the indent step", "before": ["‸a"], "keys": ":set sw=2<cr>>>", "after": ["  ‸a"] },
    { "name": ":set et after noet indents with spaces", "before": ["‸a"], "keys": ":set noet<cr>:set et ts=3<cr>>>", "after": ["   ‸a"] },
    { "name": "o after :set noet indents with a tab", "language": "rust", "before": ["‸fn f() {", "}"], "keys": ":set noet<cr>ox<esc>", "after": ["fn f() {", "\t‸x", "}"] }
  ]
}
