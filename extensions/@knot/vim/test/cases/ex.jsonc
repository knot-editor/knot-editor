// Vim behavior cases in the format described in
// crates/knot-ext-vim/tests/vim.rs: a Rust product test types `keys` through the
// real editor with this package enabled. Topic: the Ex line.
{
  "cases": [
    { "name": ":<line> goes to the line's first non-blank", "before": ["‸a", "b", "  c", "d"], "keys": ":3<cr>", "after": ["a", "b", "  ‸c", "d"] },
    { "name": ":$ goes to the last line", "before": ["‸a", "b", "c"], "keys": ":$<cr>", "after": ["a", "b", "‸c"] },
    { "name": "a line past the end goes to the last line", "before": ["‸a", "b"], "keys": ":99<cr>", "after": ["a", "‸b"] },
    { "name": ":<line> is a jump", "before": ["a", "b‸c", "d"], "keys": ":3<cr>``", "after": ["a", "b‸c", "d"] },
    { "name": "ctrl-o returns from :<line>", "before": ["‸a", "b", "c"], "keys": ":3<cr><c-o>", "after": ["‸a", "b", "c"] },
    { "name": "\": holds the last command line", "before": ["‸a", "b"], "keys": ":2<cr>\":p", "after": ["a", "b‸2"] },
    { "name": "an unknown command changes nothing", "before": ["‸a", "b"], "keys": ":frob<cr>", "after": ["‸a", "b"] },
    { "name": "Backspace on an empty Ex line leaves it without running anything", "before": ["‸a", "b"], "keys": ":<bs>j", "after": ["a", "‸b"] },
    { "name": "Backspace deletes Ex text, then leaves the line", "before": ["‸a", "b", "c"], "keys": ":2<bs><bs>j", "after": ["a", "‸b", "c"] },
    { "name": "Escape dismisses the Ex line", "before": ["‸a", "b"], "keys": ":2<esc>j", "after": ["a", "‸b"] },
    { "name": ":set noet indents with tabs", "before": ["‸a"], "keys": ":set noet<cr>>>", "after": ["\t‸a"] },
    { "name": ":set sw sets the indent step", "before": ["‸a"], "keys": ":set sw=2<cr>>>", "after": ["  ‸a"] },
    { "name": ":set et after noet indents with spaces", "before": ["‸a"], "keys": ":set noet<cr>:set et ts=3<cr>>>", "after": ["   ‸a"] },
    { "name": "o after :set noet indents with a tab", "language": "rust", "before": ["‸fn f() {", "}"], "keys": ":set noet<cr>ox<esc>", "after": ["fn f() {", "\t‸x", "}"] },
    { "name": ":s<tab> completes the command name", "before": ["‸a"], "keys": ":s<tab> noet<cr>>>", "after": ["\t‸a"] },
    { "name": ":set completes a no-prefixed option", "before": ["‸a"], "keys": ":set noexp<tab><cr>>>", "after": ["\t‸a"] },
    { "name": "Tab completes an option name from a prefix", "before": ["‸a"], "keys": ":set shi<tab>=2 noet<cr>>>", "after": ["\t‸a"] },
    { "name": "Enter runs the typed text, not the highlighted row", "before": ["‸a", "b", "c"], "keys": ":2<cr>", "after": ["a", "‸b", "c"] },
    { "name": ":d deletes the current line into the unnamed register", "before": ["a", "‸b", "c"], "keys": ":d<cr>p", "after": ["a", "c", "‸b"] },
    { "name": ":2,3d deletes a range", "before": ["‸a", "b", "c", "d"], "keys": ":2,3d<cr>", "after": ["a", "‸d"] },
    { "name": ":%d empties the buffer", "before": ["‸a", "b"], "keys": ":%d<cr>", "after": ["‸"] },
    { "name": ":d takes a register and a count", "before": ["‸a", "b", "c", "d"], "keys": ":2d x 2<cr>\"xP", "after": ["a", "‸b", "c", "d"] },
    { "name": ":d with a count starts at the last line of the range", "before": ["‸a", "b", "c", "d"], "keys": ":2d 2<cr>", "after": ["a", "‸d"] },
    { "name": ":d with a count stops at the last line", "before": ["‸a", "b", "c"], "keys": ":2d 9<cr>", "after": ["‸a"] },
    { "name": "one u undoes :d of a range", "before": ["‸a", "b", "c"], "keys": ":1,2d<cr>u", "after": ["‸a", "b", "c"] },
    { "name": ":'<,'>d works on the visual lines", "before": ["‸a", "b", "c", "d"], "keys": "jVj<esc>gg:'<lt>,'>d<cr>", "after": ["a", "‸d"] },
    { "name": ":y yanks without moving the caret", "before": ["a", "b", "‸c"], "keys": ":1,2y<cr>P", "after": ["a", "b", "‸a", "b", "c"] },
    { "name": ":y takes a register", "before": ["‸a", "b"], "keys": ":2y q<cr>\"qp", "after": ["a", "‸b", "b"] },
    { "name": ":y x then :d leaves the register alone", "before": ["‸a", "b"], "keys": ":y x<cr>:2d<cr>\"xp", "after": ["a", "‸a"] },
    { "name": ":d into a named register keeps the unnamed one", "before": ["‸a", "b", "c"], "keys": "yy:3d a<cr>p", "after": ["a", "b", "‸a"] },
    { "name": ":m moves lines below an address", "before": ["‸a", "b", "c", "d"], "keys": ":1,2m3<cr>", "after": ["c", "a", "‸b", "d"] },
    { "name": ":m0 moves lines to the top", "before": ["‸a", "b", "c"], "keys": ":3m0<cr>", "after": ["‸c", "a", "b"] },
    { "name": ":m$ moves a line to the end", "before": ["‸a", "b", "c"], "keys": ":m$<cr>", "after": ["b", "c", "‸a"] },
    { "name": ":m takes an offset address", "before": ["‸a", "b", "c", "d"], "keys": ":m.+2<cr>", "after": ["b", "c", "‸a", "d"] },
    { "name": ":m into the range itself fails", "before": ["‸a", "b", "c"], "keys": ":1,3m2<cr>", "after": ["‸a", "b", "c"] },
    { "name": "one u undoes :m", "before": ["‸a", "b", "c", "d"], "keys": ":1,2m3<cr>u", "after": ["‸a", "b", "c", "d"] },
    { "name": ":t copies lines below an address", "before": ["‸a", "b", "c"], "keys": ":1,2t$<cr>", "after": ["a", "b", "c", "a", "‸b"] },
    { "name": ":t. duplicates the line", "before": ["‸a", "b"], "keys": ":t.<cr>", "after": ["a", "‸a", "b"] },
    { "name": ":co0 copies to the top", "before": ["a", "‸b"], "keys": ":co0<cr>", "after": ["‸b", "a", "b"] },
    { "name": "one u undoes :t", "before": ["‸a", "b"], "keys": ":t$<cr>u", "after": ["‸a", "b"] },
    { "name": ":> indents the line", "before": ["‸a", "b"], "keys": ":><cr>", "after": ["    ‸a", "b"] },
    { "name": ":>> indents twice", "before": ["‸a"], "keys": ":>><cr>", "after": ["        ‸a"] },
    { "name": ":1,2> indents a range", "before": ["a", "b", "‸c"], "keys": ":1,2><cr>", "after": ["    ‸a", "    b", "c"] },
    { "name": ":< outdents", "before": ["        ‸a"], "keys": ":<lt><cr>", "after": ["    ‸a"] },
    { "name": ":'<,'>> indents the visual lines", "before": ["‸a", "b", "c"], "keys": "Vj<esc>:'<lt>,'>><cr>", "after": ["    ‸a", "    b", "c"] },
    { "name": "one u undoes :>", "before": ["‸a", "b"], "keys": ":%><cr>u", "after": ["‸a", "b"] },
    { "name": ":j joins the line with the next", "before": ["‸a", "  b", "c"], "keys": ":j<cr>", "after": ["a‸ b", "c"] },
    { "name": ":1,3j joins a range", "before": ["a", "b", "c", "‸d"], "keys": ":1,3j<cr>", "after": ["a b‸ c", "d"] },
    { "name": ":j with a count joins that many lines", "before": ["‸a", "b", "c", "d"], "keys": ":j 3<cr>", "after": ["a b‸ c", "d"] },
    { "name": ":j! adds no space", "before": ["‸a", "  b", "c"], "keys": ":j!<cr>", "after": ["‸a  b", "c"] },
    { "name": ":2,2j does nothing", "before": ["‸a", "b"], "keys": ":2,2j<cr>", "after": ["‸a", "b"] },
    { "name": "one u undoes :j", "before": ["‸a", "b", "c"], "keys": ":%j<cr>u", "after": ["‸a", "b", "c"] },
    { "name": "a range past the buffer is invalid", "before": ["‸a", "b"], "keys": ":1,9d<cr>", "after": ["‸a", "b"] },
    { "name": "a range on a command without one is invalid", "before": ["‸a", "b"], "keys": ":1,2pwd<cr>", "after": ["‸a", "b"] },
    { "name": ":sort orders every line", "before": ["‸c", "a", "b"], "keys": ":sort<cr>", "after": ["‸a", "b", "c"] },
    { "name": ":sort! reverses", "before": ["‸c", "a", "b"], "keys": ":sort!<cr>", "after": ["‸c", "b", "a"] },
    { "name": ":sort i ignores case", "before": ["‸b", "A", "a", "B"], "keys": ":sort i<cr>", "after": ["‸A", "a", "b", "B"] },
    { "name": ":sort n orders by number", "before": ["‸x10", "x9", "none", "x-1"], "keys": ":sort n<cr>", "after": ["‸none", "x-1", "x9", "x10"] },
    { "name": ":sort u drops repeats", "before": ["‸b", "a", "b", "a"], "keys": ":sort u<cr>", "after": ["‸a", "b"] },
    { "name": ":sort takes its flags together", "before": ["‸b", "A", "a"], "keys": ":sort! iu<cr>", "after": ["‸b", "A"] },
    { "name": ":2,3sort sorts the range only", "before": ["‸z", "c", "b", "a"], "keys": ":2,3sort<cr>", "after": ["z", "‸b", "c", "a"] },
    { "name": ":sort puts the caret on the first sorted line", "before": ["a", "‸b", "  c"], "keys": ":2,3sort<cr>", "after": ["a", "  ‸c", "b"] },
    { "name": "one u undoes :sort", "before": ["‸c", "a", "b"], "keys": ":sort<cr>u", "after": ["‸c", "a", "b"] },
    { "name": ":sort with a bad flag changes nothing", "before": ["‸b", "a"], "keys": ":sort x<cr>", "after": ["‸b", "a"] }
  ]
}