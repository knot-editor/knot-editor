// Vim behavior cases in the format described in
// crates/knot-ext-vim/tests/vim.rs: a Rust product test types `keys` through the
// real editor with this package enabled. Topic: search.
{
  "cases": [
    { "name": "/ jumps to the next match after the caret", "before": ["‸a foo", "b foo"], "keys": "/foo<cr>", "after": ["a ‸foo", "b foo"] },
    { "name": "a match at the caret is skipped", "before": ["‸foo foo"], "keys": "/foo<cr>", "after": ["foo ‸foo"] },
    { "name": "/ wraps past the end", "before": ["foo", "‸x foo"], "keys": "/foo<cr>", "after": ["foo", "x ‸foo"] },
    { "name": "/ wraps to the first match", "before": ["foo", "x ‸foo", "y"], "keys": "/foo<cr>", "after": ["‸foo", "x foo", "y"] },
    { "name": "n goes to the next match", "before": ["‸a foo b foo c foo"], "keys": "/foo<cr>n", "after": ["a foo b ‸foo c foo"] },
    { "name": "n wraps around the buffer", "before": ["‸a foo b foo"], "keys": "/foo<cr>nn", "after": ["a ‸foo b foo"] },
    { "name": "N goes back", "before": ["‸a foo b foo c foo"], "keys": "/foo<cr>nN", "after": ["a ‸foo b foo c foo"] },
    { "name": "? searches backward", "before": ["foo a foo b ‸c"], "keys": "?foo<cr>", "after": ["foo a ‸foo b c"] },
    { "name": "? wraps to the last match", "before": ["a ‸b foo"], "keys": "?foo<cr>?foo<cr>", "after": ["a b ‸foo"] },
    { "name": "n after ? keeps searching backward and N reverses it", "before": ["foo a foo b foo ‸c"], "keys": "?foo<cr>n", "after": ["foo a ‸foo b foo c"] },
    { "name": "N after ? searches forward", "before": ["foo a foo b foo ‸c"], "keys": "?foo<cr>?<cr>N", "after": ["foo a foo b ‸foo c"] },
    { "name": "a count steps that many matches", "before": ["‸a foo foo foo"], "keys": "2/foo<cr>", "after": ["a foo ‸foo foo"] },
    { "name": "a count repeats n", "before": ["‸a foo foo foo foo"], "keys": "/foo<cr>2n", "after": ["a foo foo ‸foo foo"] },
    { "name": "an empty pattern searches the last one again", "before": ["‸a foo b foo"], "keys": "/foo<cr>/<cr>", "after": ["a foo b ‸foo"] },
    { "name": "a missing pattern leaves the caret", "before": ["a ‸b c"], "keys": "/zzz<cr>", "after": ["a ‸b c"] },
    { "name": "Escape leaves the prompt without searching", "before": ["‸a foo"], "keys": "/foo<esc>", "after": ["‸a foo"] },
    { "name": "searches ignore case by default", "before": ["‸a FOO"], "keys": "/foo<cr>", "after": ["a ‸FOO"] },
    { "name": "smartcase makes an uppercase pattern case-sensitive", "before": ["‸x foo Foo"], "keys": "/Foo<cr>", "after": ["x foo ‸Foo"] },
    { "name": "\\c makes a search ignore case despite smartcase", "before": ["‸x foo Foo"], "keys": "/\\cFoo<cr>", "after": ["x ‸foo Foo"] },
    { "name": "\\C makes a search case-sensitive", "before": ["‸x Foo foo"], "keys": "/\\Cfoo<cr>", "after": ["x Foo ‸foo"] },
    { "name": ":set noic makes searches case-sensitive", "before": ["‸x FOO foo"], "keys": ":set noic<cr>/foo<cr>", "after": ["x FOO ‸foo"] },
    { "name": ":set ic restores ignoring case", "before": ["‸x FOO foo"], "keys": ":set noic<cr>:set ic<cr>/foo<cr>", "after": ["x ‸FOO foo"] },
    { "name": ":set noscs makes an uppercase pattern ignore case", "before": ["‸x foo Foo"], "keys": ":set noscs<cr>/Foo<cr>", "after": ["x ‸foo Foo"] },
    { "name": "Vim's magic syntax: groups, alternation and quantifiers", "before": ["‸a xyz abab"], "keys": "/\\(ab\\)\\+<cr>", "after": ["a xyz ‸abab"] },
    { "name": "alternation", "before": ["‸a b c"], "keys": "/c\\|b<cr>", "after": ["a ‸b c"] },
    { "name": "literal parentheses and plus", "before": ["‸a (b+c) d"], "keys": "/(b+c)<cr>", "after": ["a ‸(b+c) d"] },
    { "name": "\\< and \\> match word edges", "before": ["‸a foobar bar"], "keys": "/\\<lt>bar\\><cr>", "after": ["a foobar ‸bar"] },
    { "name": "\\v makes operators bare", "before": ["‸a b abab"], "keys": "/\\v(ab)+<cr>", "after": ["a b ‸abab"] },
    { "name": "\\V makes everything literal", "before": ["‸a b a.b"], "keys": "/\\Va.b<cr>", "after": ["a b ‸a.b"] },
    { "name": "a pattern can match across lines", "before": ["‸a", "b", "c"], "keys": "/b\\nc<cr>", "after": ["a", "‸b", "c"] },
    { "name": "an unsupported atom fails without moving", "before": ["‸a foo"], "keys": "/o\\zs<cr>", "after": ["‸a foo"] },
    { "name": "an invalid pattern fails without moving", "before": ["‸a foo"], "keys": "/\\(<cr>", "after": ["‸a foo"] },
    { "name": "* searches the whole word at the caret", "before": ["‸foo foobar foo"], "keys": "*", "after": ["foo foobar ‸foo"] },
    { "name": "* from inside a word", "before": ["f‸oo foobar foo"], "keys": "*", "after": ["foo foobar ‸foo"] },
    { "name": "* uses the next word when the caret is on a blank", "before": ["a‸ foo b foo"], "keys": "*", "after": ["a foo b ‸foo"] },
    { "name": "g* matches inside longer words", "before": ["‸foo foobar"], "keys": "g*", "after": ["foo ‸foobar"] },
    { "name": "# searches the word backward", "before": ["foo a foo b ‸foo"], "keys": "#", "after": ["foo a ‸foo b foo"] },
    { "name": "# from inside a word leaves it", "before": ["foo a f‸oo"], "keys": "#", "after": ["‸foo a foo"] },
    { "name": "g# matches inside longer words", "before": ["foobar a ‸foo"], "keys": "g#", "after": ["‸foobar a foo"] },
    { "name": "* ignores smartcase", "before": ["‸Foo foo"], "keys": "*", "after": ["Foo ‸foo"] },
    { "name": "n repeats * and wraps", "before": ["x ‸foo y foo"], "keys": "*n", "after": ["x ‸foo y foo"] },
    { "name": "* escapes the word's characters", "before": ["‸a.b a.b axb"], "keys": "g*", "after": ["a.b ‸a.b axb"] },
    { "name": "* on punctuation searches the text itself", "before": ["‸++ -- ++"], "keys": "*", "after": ["++ -- ‸++"] },
    { "name": "a search is a jump", "before": ["‸a foo"], "keys": "/foo<cr>``", "after": ["‸a foo"] },
    { "name": "ctrl-o returns from a search", "before": ["‸a", "b", "foo"], "keys": "/foo<cr><c-o>", "after": ["‸a", "b", "foo"] },
    { "name": "n is a jump", "before": ["‸a", "foo", "b", "foo"], "keys": "/foo<cr>n<c-o>", "after": ["a", "‸foo", "b", "foo"] },
    { "name": "d/ deletes up to the match, exclusive", "before": ["‸a foo b"], "keys": "d/foo<cr>", "after": ["‸foo b"] },
    { "name": "d/ across lines to a line start deletes whole lines", "before": ["‸a", "b", "foo"], "keys": "d/foo<cr>", "after": ["‸foo"] },
    { "name": "d/ from the middle of a line stops before the line break", "before": ["x ‸a", "foo"], "keys": "d/foo<cr>", "after": ["x‸ ", "foo"] },
    { "name": "dn deletes to the next match", "before": ["‸a foo b foo"], "keys": "/foo<cr>ggdn", "after": ["‸foo b foo"] },
    { "name": "d? deletes backward to the match", "before": ["foo a ‸b"], "keys": "d?foo<cr>", "after": ["‸b"] },
    { "name": "c/ changes up to the match", "before": ["‸a foo"], "keys": "c/foo<cr>", "after": { "text": ["‸foo"], "mode": "insert" } },
    { "name": "y/ yanks up to the match without moving", "before": ["‸a foo"], "keys": "y/foo<cr>$p", "after": ["a fooa‸ "] },
    { "name": "d* deletes to the next occurrence of the word", "before": ["‸foo a foo"], "keys": "d*", "after": ["‸foo"] },
    { "name": "v/ extends the selection through the match's first character", "before": ["‸a foo bar"], "keys": "v/foo<cr>d", "after": ["‸oo bar"] },
    { "name": "vn extends the selection", "before": ["‸a foo b foo c"], "keys": "/foo<cr>ggvnd", "after": ["‸oo b foo c"] },
    { "name": "V/ selects whole lines up to the match", "before": ["‸a", "b", "foo", "c"], "keys": "V/foo<cr>d", "after": ["‸c"] },
    { "name": "\"/ holds the last pattern", "before": ["‸a"], "keys": "/b\\+<cr>\"/p", "after": ["ab\\‸+"] },
    { "name": "* sets the / register", "before": ["‸foo"], "keys": "*\"/P", "after": ["\\<foo\\‸>foo"] },
    { "name": "the prompt lists earlier searches and Tab recalls one", "before": ["‸a foo b bar"], "keys": "/bar<cr>gg/<tab><cr>", "after": ["a foo b ‸bar"] },
    { "name": "the Ex line recalls an earlier line through Tab", "before": ["‸a", "b", "c"], "keys": ":3<cr>gg:<tab><cr>", "after": ["a", "b", "‸c"] },
    { "name": "* adds its pattern to the search history", "before": ["‸foo x foo"], "keys": "*gg/<tab><cr>", "after": ["foo x ‸foo"] },
    { "name": "Down moves to an older search", "before": ["‸a foo b bar"], "keys": "/foo<cr>/bar<cr>gg/<down><tab><cr>", "after": ["a ‸foo b bar"] },
    { "name": "Down moves to an older Ex line", "before": ["‸a", "b", "c"], "keys": ":2<cr>:3<cr>gg:<down><tab><cr>", "after": ["a", "‸b", "c"] },
    { "name": "Enter submits the typed text, not the highlighted entry", "before": ["‸a foo bar"], "keys": "/foo<cr>gg/bar<cr>", "after": ["a foo ‸bar"] }
  ]
}
