    { "name": "3r replaces three characters", "before": ["‸abcd"], "keys": "3rx", "after": ["xx‸xd"] },
    { "name": "r with too large a count does nothing", "before": ["a‸bc"], "keys": "5rx", "after": ["a‸bc"] },
    { "name": "r on an empty line does nothing", "before": ["‸"], "keys": "rx", "after": ["‸"] },
    { "name": "~ switches case and moves on", "before": ["‸ab"], "keys": "~", "after": ["A‸b"] },
    { "name": "3~ switches three characters", "before": ["‸aBcd"], "keys": "3~", "after": ["AbC‸d"] },
    { "name": "~ on the last character stays", "before": ["a‸b"], "keys": "~", "after": ["a‸B"] },
    { "name": "J joins the next line with a space", "before": ["‸a", "  b"], "keys": "J", "after": ["a‸ b"] },
    { "name": "3J joins three lines", "before": ["‸a", "b", "c", "d"], "keys": "3J", "after": ["a b‸ c", "d"] },
