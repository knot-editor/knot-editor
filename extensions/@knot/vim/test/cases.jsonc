    { "name": "=ap reindents a Rust block", "language": "rust", "before": ["fn f() {", "a();", "‸  b();", "}"], "keys": "=ap", "after": ["‸fn f() {", "    a();", "    b();", "}"] },
    { "name": "== reindents a TypeScript line", "language": "typescript", "before": ["function f() {", "‸a();", "}"], "keys": "==", "after": ["function f() {", "    ‸a();", "}"] },
    { "name": ">> in Rust indents by the tab size", "language": "rust", "before": ["‸a();"], "keys": ">>", "after": ["    ‸a();"] },

    // Case operators.
    { "name": "gUiw uppercases a word", "before": ["foo b‸ar"], "keys": "gUiw", "after": ["foo ‸BAR"] },
    { "name": "guu lowercases the line", "before": ["AB‸C"], "keys": "guu", "after": ["ab‸c"] },
    { "name": "gUU uppercases the line", "before": ["ab‸c"], "keys": "gUU", "after": ["AB‸C"] },
    { "name": "g~~ switches the line's case", "before": ["a‸B"], "keys": "g~~", "after": ["A‸b"] },
    { "name": "gUgU uppercases the line", "before": ["‸ab"], "keys": "gUgU", "after": ["‸AB"] },
    { "name": "g~w switches a word's case", "before": ["‸aB c"], "keys": "g~w", "after": ["‸Ab c"] },
    { "name": "gu$ lowercases to the line end", "before": ["A‸BC"], "keys": "gu$", "after": ["A‸bc"] },

    // r, ~, and J.
