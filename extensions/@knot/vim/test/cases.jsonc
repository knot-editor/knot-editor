    { "name": "vw selects through the next word's first character", "before": ["‸foo bar"], "keys": "vw", "after": ["‸foo b‸ar"], "mode": "visual" },
    { "name": "ve selects to the word end", "before": ["‸foo bar"], "keys": "ve", "after": ["‸foo‸ bar"], "mode": "visual" },
    { "name": "vb selects back to the word start", "before": ["foo ba‸r"], "keys": "vb", "after": ["foo ‸bar‸"], "mode": "visual" },
    { "name": "v$ includes the line break", "before": ["‸ab", "cd"], "keys": "v$", "after": ["‸ab", "‸cd"], "mode": "visual" },
    { "name": "v0 selects to the line start", "before": ["ab‸c"], "keys": "v0", "after": ["‸abc‸"], "mode": "visual" },
    { "name": "vj keeps the column", "before": ["a‸bc", "def"], "keys": "vj", "after": ["a‸bc", "de‸f"], "mode": "visual" },
    { "name": "vG selects to the last line", "before": ["a‸b", "c", "d"], "keys": "vG", "after": ["a‸b", "c", "d‸"], "mode": "visual" },
    { "name": "vf selects through the character", "before": ["‸a.b"], "keys": "vf.", "after": ["‸a.‸b"], "mode": "visual" },
    { "name": "v% selects to the matching bracket", "before": ["‸(a)b"], "keys": "v%", "after": ["‸(a)‸b"], "mode": "visual" },
    { "name": "v} selects to the empty line", "before": ["a", "‸b", "", "c"], "keys": "v}", "after": ["a", "‸b", "", "‸c"], "mode": "visual" },
    { "name": "o moves the caret to the other end", "before": ["a‸bcd"], "keys": "vlloh", "after": ["‸abcd‸"], "mode": "visual" },
    { "name": "Escape leaves visual mode at the caret", "before": ["‸abc"], "keys": "vll<esc>", "after": ["ab‸c"] },
    { "name": "Escape after v$ steps back onto the line", "before": ["‸ab", "cd"], "keys": "v$<esc>", "after": ["a‸b", "cd"] },
    { "name": "v again leaves visual mode", "before": ["‸abc"], "keys": "vlv", "after": ["a‸bc"] },
