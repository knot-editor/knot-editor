// Vim behavior cases, run by a Rust product test through the real editor
// with this package enabled. Lines join with "\n" and "‸" marks the caret,
// which in normal mode sits on the character after it. Two markers are a
// selection, anchor first in `before`; in a visual mode the selection runs
// through the character under Vim's caret, a line break included. `keys` types its
// characters; `<name>` presses a named key: <esc>, <cr>, <bs>, <del>, <tab>,
// <s-tab>, <left>, <right>, <up>, <down>, <home>, <end>, <lt> for "<", and
// <c-x> for ctrl with a letter. Keys arrive
// without waiting for each other, as fast typing does. `mode` is the mode
// afterwards, "normal" unless given, or "insert", "visual", or "visual-line";
// `language` sets the document's language.
{
  "cases": [
    // Character and line motions.
    { "name": "l stops on the last character", "before": ["‸abc"], "keys": "5l", "after": ["ab‸c"] },
    { "name": "h stops at the line start", "before": ["a‸bc"], "keys": "5h", "after": ["‸abc"] },
    { "name": "l steps over a surrogate pair", "before": ["‸😀a"], "keys": "l", "after": ["😀‸a"] },
    { "name": "a count of ten moves ten characters", "before": ["‸abcdefghijkl"], "keys": "10l", "after": ["abcdefghij‸kl"] },
    { "name": "Backspace moves left onto the previous line", "before": ["ab", "‸cd"], "keys": "<bs>", "after": ["a‸b", "cd"] },
    { "name": "Space moves right onto the next line", "before": ["a‸b", "cd"], "keys": " ", "after": ["ab", "‸cd"] },
    { "name": "0 goes to the line start", "before": ["  fo‸o"], "keys": "0", "after": ["‸  foo"] },
    { "name": "the arrows move as h, j, k, and l", "before": ["‸abc", "def"], "keys": "<right><down><right><up><left>", "after": ["a‸bc", "def"] },
    { "name": "Home and End go to the line's ends", "before": ["a‸bc"], "keys": "<end>x<home>x", "after": ["‸b"] },
    { "name": "d with Down deletes two lines", "before": ["‸a", "b", "c"], "keys": "d<down>", "after": ["‸c"] },
    { "name": "^ goes to the first non-blank", "before": ["‸  foo"], "keys": "^", "after": ["  ‸foo"] },
    { "name": "$ goes to the last character", "before": ["‸  foo"], "keys": "$", "after": ["  fo‸o"] },
    { "name": "2$ goes to the end of the next line", "before": ["‸ab", "cd"], "keys": "2$", "after": ["ab", "c‸d"] },
    { "name": "Enter goes to the next line's first non-blank", "before": ["‸a", "  b", "c"], "keys": "<cr>", "after": ["a", "  ‸b", "c"] },
    { "name": "+ with a count skips lines", "before": ["‸a", "b", "  c"], "keys": "2+", "after": ["a", "b", "  ‸c"] },
    { "name": "- goes to the previous line's first non-blank", "before": ["a", "  b", "‸c"], "keys": "-", "after": ["a", "  ‸b", "c"] },
    { "name": "gg goes to the first line's first non-blank", "before": ["  one", "two", "th‸ree"], "keys": "gg", "after": ["  ‸one", "two", "three"] },
    { "name": "G goes to the last line", "before": ["‸one", "two", "  three"], "keys": "G", "after": ["one", "two", "  ‸three"] },
    { "name": "a count before G names the line", "before": ["‸one", "  two", "three"], "keys": "2G", "after": ["one", "  ‸two", "three"] },
    { "name": "a count before gg names the line", "before": ["‸one", "two", "three"], "keys": "3gg", "after": ["one", "two", "‸three"] },

    // j and k.
    { "name": "j keeps the wanted column across short and empty lines", "before": ["abc‸def", "ab", "", "abcdefgh"], "keys": "jjj", "after": ["abcdef", "ab", "", "abc‸defgh"] },
    { "name": "j clamps to a short line's last character", "before": ["abc‸def", "ab"], "keys": "j", "after": ["abcdef", "a‸b"] },
    { "name": "k keeps the wanted column", "before": ["abcdef", "", "abc‸d"], "keys": "kk", "after": ["abc‸def", "", "abcd"] },
    { "name": "after $, j stays at line ends", "before": ["a‸b", "abcd", "x"], "keys": "$jj", "after": ["ab", "abcd", "‸x"] },
    { "name": "after $, j lands on a longer line's end", "before": ["a‸b", "abcd"], "keys": "$j", "after": ["ab", "abc‸d"] },
    { "name": "j counts a tab as reaching the next tab stop", "before": ["abcd‸e", "\tx"], "keys": "j", "after": ["abcde", "\t‸x"] },
    { "name": "j inside a tab lands on the tab", "before": ["a‸bcde", "\tx"], "keys": "j", "after": ["abcde", "‸\tx"] },
    { "name": "a count of j past the end stops on the last line", "before": ["‸a", "b", "c"], "keys": "5j", "after": ["a", "b", "‸c"] },
    { "name": "k on the first line stays", "before": ["a‸b"], "keys": "k", "after": ["a‸b"] },

    // Word motions.
    { "name": "w stops at punctuation and words", "before": ["‸foo.bar baz"], "keys": "w", "after": ["foo‸.bar baz"] },
    { "name": "3w moves three words", "before": ["‸foo.bar baz"], "keys": "3w", "after": ["foo.bar ‸baz"] },
    { "name": "w crosses lines and stops on an empty line", "before": ["foo ‸bar", "", "baz"], "keys": "w", "after": ["foo bar", "‸", "baz"] },
    { "name": "w after an empty line goes to the next word", "before": ["foo ‸bar", "", "  baz"], "keys": "ww", "after": ["foo bar", "", "  ‸baz"] },
    { "name": "w on the last word goes to the last character", "before": ["foo ‸bar"], "keys": "w", "after": ["foo ba‸r"] },
    { "name": "w separates letters from emoji", "before": ["‸é😀 x"], "keys": "w", "after": ["é‸😀 x"] },
    { "name": "W skips punctuation", "before": ["‸a.b c"], "keys": "W", "after": ["a.b ‸c"] },
    { "name": "b goes to the previous word start", "before": ["foo ba‸r"], "keys": "b", "after": ["foo ‸bar"] },
    { "name": "2b goes back two words", "before": ["foo ba‸r"], "keys": "2b", "after": ["‸foo bar"] },
    { "name": "b crosses lines", "before": ["foo", "  ‸bar"], "keys": "b", "after": ["‸foo", "  bar"] },
    { "name": "B skips punctuation", "before": ["a.b ‸c"], "keys": "B", "after": ["‸a.b c"] },
    { "name": "e goes to the word end", "before": ["‸foo bar"], "keys": "e", "after": ["fo‸o bar"] },
    { "name": "e from a word end goes to the next one", "before": ["fo‸o bar"], "keys": "e", "after": ["foo ba‸r"] },
    { "name": "e skips empty lines", "before": ["fo‸o", "", "bar"], "keys": "e", "after": ["foo", "", "ba‸r"] },
    { "name": "E skips punctuation", "before": ["‸a.b c"], "keys": "E", "after": ["a.‸b c"] },
    { "name": "ge goes to the previous word end", "before": ["foo b‸ar"], "keys": "ge", "after": ["fo‸o bar"] },
    { "name": "gE skips punctuation", "before": ["a.b ‸c"], "keys": "gE", "after": ["a.‸b c"] },

    // f, t, ;, and ,.
    { "name": "f finds a character on the line", "before": ["‸a.b.c"], "keys": "f.", "after": ["a‸.b.c"] },
    { "name": "2f finds the second", "before": ["‸a.b.c"], "keys": "2f.", "after": ["a.b‸.c"] },
    { "name": "F finds backwards", "before": ["a.b.‸c"], "keys": "F.", "after": ["a.b‸.c"] },
    { "name": "t stops before the character", "before": ["‸abcd"], "keys": "tc", "after": ["a‸bcd"] },
    { "name": "T stops after the character", "before": ["abc‸d"], "keys": "Ta", "after": ["a‸bcd"] },
    { "name": "f without a match stays", "before": ["a‸bc"], "keys": "fz", "after": ["a‸bc"] },
    { "name": "; repeats f", "before": ["‸a.b.c"], "keys": "f.;", "after": ["a.b‸.c"] },
    { "name": ", repeats f backwards", "before": ["‸a.b.c"], "keys": "2f.,", "after": ["a‸.b.c"] },
    { "name": "; after t moves on to the next match", "before": ["‸a.b.c"], "keys": "t.;", "after": ["a.‸b.c"] },
    { "name": "f finds a tab", "before": ["‸a\tb"], "keys": "f<tab>", "after": ["a‸\tb"] },

    // %, {, and }.
    { "name": "% jumps to the matching bracket", "before": ["‸(a (b) c)"], "keys": "%", "after": ["(a (b) c‸)"] },
    { "name": "% jumps back to the opener", "before": ["(a (b) c‸)"], "keys": "%", "after": ["‸(a (b) c)"] },
    { "name": "% finds the next bracket on the line", "before": ["‸x = f(a);"], "keys": "%", "after": ["x = f(a‸);"] },
    { "name": "% from inside a pair uses the next bracket", "before": ["f(a‸, b)"], "keys": "%", "after": ["f‸(a, b)"] },
    { "name": "% matches an adjacent pair", "before": ["‸()"], "keys": "%", "after": ["(‸)"] },
    { "name": "% skips brackets in strings with syntax", "language": "rust", "before": ["fn f() ‸{ \"}\"; }"], "keys": "%", "after": ["fn f() { \"}\"; ‸}"] },
    { "name": "% spans lines", "language": "rust", "before": ["fn f() ‸{", "    a();", "}"], "keys": "%", "after": ["fn f() {", "    a();", "‸}"] },
    { "name": "a count before % goes to that percentage of lines", "before": ["‸a", "b", "c", "d"], "keys": "50%", "after": ["a", "‸b", "c", "d"] },
    { "name": "} goes to the next empty line", "before": ["‸a", "b", "", "c"], "keys": "}", "after": ["a", "b", "‸", "c"] },
    { "name": "} at the last paragraph goes to the last character", "before": ["‸a", "bc"], "keys": "}", "after": ["a", "b‸c"] },
    { "name": "2} skips a paragraph", "before": ["‸a", "", "b", "", "c"], "keys": "2}", "after": ["a", "", "b", "‸", "c"] },
    { "name": "{ goes to the previous empty line", "before": ["a", "", "b", "‸c"], "keys": "{", "after": ["a", "‸", "b", "c"] },
    { "name": "{ at the first paragraph goes to the first line", "before": ["a", "b‸c"], "keys": "{", "after": ["‸a", "bc"] },

    // d.
    { "name": "dw deletes a word and its white space", "before": ["‸foo bar"], "keys": "dw", "after": ["‸bar"] },
    { "name": "dw on the line's last word keeps the line break", "before": ["foo ‸bar", "baz"], "keys": "dw", "after": ["foo‸ ", "baz"] },
    { "name": "dw on the document's last word deletes to its end", "before": ["foo b‸ar"], "keys": "dw", "after": ["foo ‸b"] },
    { "name": "d2w and 2dw delete two words", "before": ["‸a b c d e"], "keys": "d2w2dw", "after": ["‸e"] },
    { "name": "de deletes to the word end", "before": ["‸foo bar"], "keys": "de", "after": ["‸ bar"] },
    { "name": "db deletes back to the word start", "before": ["foo ba‸r"], "keys": "db", "after": ["foo ‸r"] },
    { "name": "d$ deletes to the line end", "before": ["ab‸cd", "e"], "keys": "d$", "after": ["a‸b", "e"] },
    { "name": "D deletes to the line end", "before": ["ab‸cd"], "keys": "D", "after": ["a‸b"] },
    { "name": "d0 deletes to the line start", "before": ["ab‸cd"], "keys": "d0", "after": ["‸cd"] },
    { "name": "dd deletes the line", "before": ["a", "  ‸b", "  c"], "keys": "dd", "after": ["a", "  ‸c"] },
    { "name": "dd on the last line goes to the line above", "before": ["  a", "‸b"], "keys": "dd", "after": ["  ‸a"] },
    { "name": "3dd deletes three lines", "before": ["‸a", "b", "c", "d"], "keys": "3dd", "after": ["‸d"] },
    { "name": "a count past the end deletes to the end", "before": ["a", "‸b", "c"], "keys": "9dd", "after": ["‸a"] },
    { "name": "dd on the only line empties the document", "before": ["a‸b"], "keys": "dd", "after": ["‸"] },
    { "name": "dj deletes this line and the next", "before": ["‸a", "b", "c"], "keys": "dj", "after": ["‸c"] },
    { "name": "dk deletes this line and the previous", "before": ["a", "b", "‸c"], "keys": "dk", "after": ["‸a"] },
    { "name": "dj on the last line does nothing", "before": ["a", "‸b"], "keys": "dj", "after": ["a", "‸b"] },
    { "name": "dG deletes to the last line", "before": ["a", "‸b", "c"], "keys": "dG", "after": ["‸a"] },
    { "name": "dgg deletes to the first line", "before": ["a", "‸b", "c"], "keys": "dgg", "after": ["‸c"] },
    { "name": "dfx deletes through the character", "before": ["‸a.b.c"], "keys": "df.", "after": ["‸b.c"] },
    { "name": "dtx deletes up to the character", "before": ["‸a.b.c"], "keys": "dt.", "after": ["‸.b.c"] },
    { "name": "dfx without a match does nothing", "before": ["‸abc"], "keys": "dfz", "after": ["‸abc"] },
    { "name": "d% deletes through the matching bracket", "before": ["a‸(b)c"], "keys": "d%", "after": ["a‸c"] },
    { "name": "d} from a paragraph start deletes its lines", "before": ["‸a", "b", "", "c"], "keys": "d}", "after": ["‸", "c"] },
    { "name": "d} from inside a line keeps what is before", "before": ["a‸b", "c", "", "d"], "keys": "d}", "after": ["‸a", "", "d"] },
    { "name": "x deletes the character", "before": ["a‸bc"], "keys": "x", "after": ["a‸c"] },
    { "name": "x on the last character steps back", "before": ["ab‸c"], "keys": "x", "after": ["a‸b"] },
    { "name": "3x deletes three characters", "before": ["‸abcd"], "keys": "3x", "after": ["‸d"] },
    { "name": "x past the end deletes to the end", "before": ["a‸bc"], "keys": "5x", "after": ["‸a"] },
    { "name": "x on an empty line does nothing", "before": ["‸", "a"], "keys": "x", "after": ["‸", "a"] },
    { "name": "X deletes before the caret", "before": ["ab‸c"], "keys": "X", "after": ["a‸c"] },
    { "name": "X at the line start does nothing", "before": ["‸abc"], "keys": "X", "after": ["‸abc"] },
    { "name": "x deletes a surrogate pair whole", "before": ["a‸😀b"], "keys": "x", "after": ["a‸b"] },

    // c.
    { "name": "cw changes to the word end", "before": ["‸foo bar"], "keys": "cwx<esc>", "after": ["‸x bar"] },
    { "name": "cw on a word's last character changes it alone", "before": ["fo‸o bar"], "keys": "cwx<esc>", "after": ["fo‸x bar"] },
    { "name": "c2w changes two words", "before": ["‸a b c"], "keys": "c2wx<esc>", "after": ["‸x c"] },
    { "name": "cw on white space changes up to the next word", "before": ["a‸  b"], "keys": "cwx<esc>", "after": ["a‸xb"] },
    { "name": "cc keeps the indentation", "before": ["  a‸b", "c"], "keys": "ccx<esc>", "after": ["  ‸x", "c"] },
    { "name": "cc left empty keeps no indentation", "before": ["  a‸b", "c"], "keys": "cc<esc>", "after": ["‸", "c"] },
    { "name": "S changes the line", "before": ["a‸b"], "keys": "Sx<esc>", "after": ["‸x"] },
    { "name": "C changes to the line end", "before": ["a‸bc"], "keys": "Cx<esc>", "after": ["a‸x"] },
    { "name": "s substitutes a character", "before": ["a‸bc"], "keys": "sxy<esc>", "after": ["ax‸yc"] },
    { "name": "2s substitutes two characters", "before": ["‸abc"], "keys": "2sx<esc>", "after": ["‸xc"] },
    { "name": "s on an empty line inserts", "before": ["‸"], "keys": "sx<esc>", "after": ["‸x"] },
    { "name": "c leaves insert mode active", "before": ["‸foo"], "keys": "cw", "after": ["‸"], "mode": "insert" },
    // Undo restores the caret from before the change, where Vim puts it at
    // the change's start.
    { "name": "ciw…<Esc> undoes as one step", "before": ["foo b‸ar baz"], "keys": "ciwxy<esc>u", "after": ["foo b‸ar baz"] },
    { "name": "cw…<Esc> with a line break undoes as one step", "before": ["‸foo bar"], "keys": "cwx<cr>y<esc>u", "after": ["‸foo bar"] },

    // y and p.
    { "name": "yy then p puts the line below", "before": ["‸a", "b"], "keys": "yyp", "after": ["a", "‸a", "b"] },
    { "name": "yy then P puts the line above", "before": ["a", "‸b"], "keys": "yyP", "after": ["a", "‸b", "b"] },
    { "name": "yy then p on the last line", "before": ["a", "  ‸b"], "keys": "yyp", "after": ["a", "  b", "  ‸b"] },
    { "name": "a count before p puts several copies", "before": ["‸a"], "keys": "yy3p", "after": ["a", "‸a", "a", "a"] },
    { "name": "dd then p moves a line down", "before": ["‸a", "b", "c"], "keys": "ddp", "after": ["b", "‸a", "c"] },
    { "name": "2yy then p puts both lines", "before": ["‸a", "b", "c"], "keys": "2yyGp", "after": ["a", "b", "c", "‸a", "b"] },
    { "name": "Y yanks the line", "before": ["‸a", "b"], "keys": "Yjp", "after": ["a", "b", "‸a"] },
    { "name": "yw then p puts after the caret", "before": ["‸foo bar"], "keys": "ywP", "after": ["foo‸ foo bar"] },
    { "name": "yiw then p puts the word after the caret", "before": ["f‸oo"], "keys": "yiw$p", "after": ["foofo‸o"] },
    { "name": "yb moves the caret to the start", "before": ["foo ‸bar"], "keys": "yb", "after": ["‸foo bar"] },
    { "name": "x then p swaps characters", "before": ["‸ab"], "keys": "xp", "after": ["b‸a"] },
    { "name": "p on an empty line puts there", "before": ["‸ab", ""], "keys": "yiwjp", "after": ["ab", "a‸b"] },
    { "name": "2p repeats characterwise text", "before": ["‸ab"], "keys": "yl2p", "after": ["aa‸ab"] },
    { "name": "putting several lines of characters leaves the caret at their start", "before": ["a‸b", "cd", "x"], "keys": "yeGP", "after": ["ab", "cd", "‸b", "cdx"] },
    { "name": "a put undoes as one step", "before": ["‸a"], "keys": "yy3pu", "after": ["‸a"] },
    { "name": "dd then u restores the line", "before": ["a", "‸b", "c"], "keys": "ddu", "after": ["a", "‸b", "c"] },

    // Registers.
    { "name": "a named register keeps its text", "before": ["‸one", "two"], "keys": "\"ayyjyy\"ap", "after": ["one", "two", "‸one"] },
    { "name": "an uppercase register appends", "before": ["‸one", "two", "x"], "keys": "\"ayyj\"AyyG\"ap", "after": ["one", "two", "x", "‸one", "two"] },
    { "name": "appending characters to lines adds a line", "before": ["‸one", "two"], "keys": "\"ayyj\"Ayw\"aP", "after": ["one", "‸one", "two", "two"] },
    { "name": "\"0 keeps the last yank after a delete", "before": ["‸a", "b", "c"], "keys": "yyjdd\"0p", "after": ["a", "c", "‸a"] },
    { "name": "deletes shift through \"1 and \"2", "before": ["‸a", "b", "c"], "keys": "dddd\"2p", "after": ["c", "‸a"] },
    { "name": "a small delete goes to \"-", "before": ["‸ab", "c"], "keys": "xj\"-p", "after": ["b", "c‸a"] },
    { "name": "a small delete leaves \"1 alone", "before": ["‸a", "bc"], "keys": "ddx\"1p", "after": ["c", "‸a"] },
    { "name": "the black hole register keeps the clipboard", "before": ["‸a", "b"], "keys": "yyj\"_ddp", "after": ["a", "‸a"] },
    { "name": "\"+ is the clipboard", "before": ["‸a", "b"], "keys": "\"+yyjp", "after": ["a", "b", "‸a"] },
    { "name": "a named yank leaves the clipboard", "before": ["‸a", "b"], "keys": "yyj\"byyp", "after": ["a", "b", "‸a"] },
    { "name": "an unknown register cancels", "before": ["‸ab"], "keys": "\"!x", "after": ["‸b"] },

    // Text objects.
    { "name": "diw deletes the word", "before": ["foo b‸ar baz"], "keys": "diw", "after": ["foo ‸ baz"] },
    { "name": "daw deletes the word and the white space after", "before": ["foo b‸ar baz"], "keys": "daw", "after": ["foo ‸baz"] },
    { "name": "daw on the last word takes the white space before", "before": ["foo b‸ar"], "keys": "daw", "after": ["fo‸o"] },
    { "name": "daw keeps indentation", "before": ["  b‸ar"], "keys": "daw", "after": [" ‸ "] },
    { "name": "diw on white space deletes it", "before": ["foo ‸  bar"], "keys": "diw", "after": ["foo‸bar"] },
    { "name": "daw on white space takes the next word", "before": ["foo‸  bar baz"], "keys": "daw", "after": ["foo‸ baz"] },
    { "name": "d2aw deletes two words", "before": ["‸a b c"], "keys": "d2aw", "after": ["‸c"] },
    { "name": "d3iw deletes a word, a space, and a word", "before": ["‸a b c"], "keys": "d3iw", "after": ["‸ c"] },
    { "name": "diW includes punctuation", "before": ["x a.‸b y"], "keys": "diW", "after": ["x ‸ y"] },
    { "name": "di( deletes inside the parentheses", "before": ["f(a, ‸b)"], "keys": "di(", "after": ["f(‸)"] },
    { "name": "da( deletes the parentheses too", "before": ["f(a, ‸b) x"], "keys": "da(", "after": ["f‸ x"] },
    { "name": "dib on the opener", "before": ["f‸(a)"], "keys": "dib", "after": ["f(‸)"] },
    { "name": "di) on the closer", "before": ["f(a‸)"], "keys": "di)", "after": ["f(‸)"] },
    { "name": "d2i( deletes inside the outer pair", "before": ["(a (‸b) c)"], "keys": "d2i(", "after": ["(‸)"] },
    { "name": "di( outside any pair does nothing", "before": ["‸a (b)"], "keys": "di(", "after": ["‸a (b)"] },
    { "name": "ci( in an empty pair inserts there", "before": ["f‸()"], "keys": "ci(x<esc>", "after": ["f(‸x)"] },
    { "name": "di{ deletes a block's lines", "before": ["fn f() {", "    a‸();", "    b();", "}"], "keys": "di{", "after": ["fn f() {", "‸}"] },
    { "name": "ci{ leaves an indented line in a block", "before": ["fn f() {", "    a‸();", "}"], "keys": "ci{x<esc>", "after": ["fn f() {", "    ‸x", "}"] },
    { "name": "da{ deletes the block", "before": ["x {", "  ‸a", "} y"], "keys": "daB", "after": ["x ‸ y"] },
    { "name": "di[ and di< work", "before": ["[‸a] <b>"], "keys": "di[f<lt>di<lt>", "after": ["[] <‸>"] },
    { "name": "di\" deletes inside quotes", "before": ["x = \"a‸b\";"], "keys": "di\"", "after": ["x = \"‸\";"] },
    { "name": "da\" deletes quotes and white space after", "before": ["x \"a‸b\" y"], "keys": "da\"", "after": ["x ‸y"] },
    { "name": "da\" at the line end takes white space before", "before": ["x \"a‸b\""], "keys": "da\"", "after": ["‸x"] },
    { "name": "di\" before a quoted string uses it", "before": ["‸x \"ab\""], "keys": "di\"", "after": ["x \"‸\""] },
    { "name": "di\" skips escaped quotes", "before": ["\"a\\\"‸b\""], "keys": "di\"", "after": ["\"‸\""] },
    { "name": "di' and di` work", "before": ["'‸a' `b`"], "keys": "di'fbdi`", "after": ["'' `‸`"] },
    { "name": "dip deletes the paragraph", "before": ["a", "‸b", "", "c"], "keys": "dip", "after": ["‸", "c"] },
    { "name": "dap deletes the paragraph and the blank line after", "before": ["a", "‸b", "", "c"], "keys": "dap", "after": ["‸c"] },
    { "name": "dap on the last paragraph takes the blank lines before", "before": ["a", "", "‸b"], "keys": "dap", "after": ["‸a"] },
    { "name": "yip then P puts the paragraph", "before": ["‸a", "b", "", "c"], "keys": "yipGP", "after": ["a", "b", "", "‸a", "b", "c"] },

    // Indentation operators.
    { "name": ">> indents the line", "before": ["a‸b"], "keys": ">>", "after": ["    ‸ab"] },
    { "name": "3>> indents three lines", "before": ["‸a", "b", "c", "d"], "keys": "3>>", "after": ["    ‸a", "    b", "    c", "d"] },
    { "name": ">j indents two lines", "before": ["‸a", "b", "c"], "keys": ">j", "after": ["    ‸a", "    b", "c"] },
    { "name": "<< outdents the line", "before": ["        a‸b"], "keys": "<lt><lt>", "after": ["    ‸ab"] },
    { "name": ">ip indents the paragraph", "before": ["a", "‸b", "", "c"], "keys": ">ip", "after": ["    ‸a", "    b", "", "c"] },
    { "name": ">> undoes as one step", "before": ["a‸b"], "keys": ">>u", "after": ["a‸b"] },
