// Bracket cases, run through an editor view on each group's languages.
// Lines join with "\n" and "‸" marks the caret: one marker places it, two
// select between them. A type case types `text` there one character at a
// time, "⌫" pressing Backspace, and expects `after` with its caret or
// selection. A jump case runs Jump to Matching Bracket and expects the
// caret. A match case expects `after` to be the text with "«" and "»"
// around the brackets highlighted at the caret, or no markers when none.
{
  "languages": ["python"],
  "type": [
    {"name": "a call closes", "before": ["print‸"], "text": "(", "after": ["print(‸)"]},
    {"name": "a dictionary closes", "before": ["d = ‸"], "text": "{", "after": ["d = {‸}"]},
    {"name": "double quotes close and step over", "before": ["s = ‸"], "text": "\"ab\"", "after": ["s = \"ab\"‸"]},
    {"name": "single quotes close", "before": ["s = ‸"], "text": "'", "after": ["s = '‸'"]},
    {"name": "a quote does not close inside a string", "before": ["s = \"a ‸ b\""], "text": "'", "after": ["s = \"a '‸ b\""]},
    {"name": "a quote does not close inside a comment", "before": ["# say ‸"], "text": "'", "after": ["# say '‸"]},
    {"name": "Backspace deletes an empty pair", "before": ["x = ‸"], "text": "[⌫", "after": ["x = ‸"]},
    {"name": "an opener wraps the selection", "before": ["x = ‸a‸"], "text": "[", "after": ["x = [‸a‸]"]}
  ],
  "jump": [
    {"name": "away from brackets to the enclosing closer", "before": ["f(a, ‸b)"], "after": ["f(a, b‸)"]}
  ],
  "match": [
    {"name": "a dictionary", "before": ["d = {‸\"a\": [1]}"], "after": ["d = «{»\"a\": [1]«}»"]}
  ]
}
