{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knot extension manifest",
  "description": "knot.jsonc accepts JSON comments and trailing commas before schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "name",
    "version",
    "main"
  ],
  "properties": {
    "apiVersion": {
      "type": "integer",
      "minimum": 1,
      "const": 1,
      "description": "Required Knot public API version, independent of the package version."
    },
    "name": {
      "$ref": "#/$defs/packageName"
    },
    "version": {
      "type": "string",
      "description": "A semantic version."
    },
    "main": {
      "type": "string",
      "description": "A relative .js or .mjs file path inside the package; empty, dot, parent, and backslash segments are invalid."
    },
    "requires": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/packageName"
      }
    },
    "entitlements": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "description": "Capabilities the package needs. Knot asks the user before loading a package whose entitlements are undecided, and does not load one whose entitlement was denied.",
      "items": {
        "enum": ["process"]
      }
    },
    "displayName": {
      "$ref": "#/$defs/nonEmpty"
    },
    "description": {
      "$ref": "#/$defs/nonEmpty"
    },
    "author": {
      "$ref": "#/$defs/nonEmpty"
    },
    "website": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "license": {
      "$ref": "#/$defs/nonEmpty"
    }
  },
  "$defs": {
    "packageName": {
      "type": "string",
      "pattern": "^@(?!knot/)[a-z][a-z0-9._-]*/[a-z][a-z0-9._-]*$"
    },
    "nonEmpty": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}
